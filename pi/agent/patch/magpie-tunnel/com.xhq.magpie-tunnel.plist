<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    macmini 上默认使用 magpie 的免费模型（2026-11-11 用户立规）。

    magpie.app 只跑在本机（MacBook），代理监听 127.0.0.1:3425；macmini 上是 x64、
    magpie.app 是 arm64，装不了。所以本机主动向 macmini 建一条 SSH 反向隧道：
    macmini 的 127.0.0.1:3425 → 本机的 127.0.0.1:3425（magpie）。

    这样 macmini 上任何 harness（pi / 其它 CLI）配 `magpie/...` 模型就能直接用，
    不必再像 2026-11-11 那样被迫切到 deepseek 官方付费模型。

    断线由 launchd KeepAlive 自动重连（本机睡眠 / 网络切换后恢复）。
  -->
  <key>Label</key><string>com.xhq.magpie-tunnel</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/ssh</string>
    <string>-N</string>
    <string>-T</string>
    <string>-o</string><string>ExitOnForwardFailure=yes</string>
    <string>-o</string><string>BatchMode=yes</string>
    <string>-o</string><string>ServerAliveInterval=30</string>
    <string>-o</string><string>ServerAliveCountMax=3</string>
    <string>-o</string><string>ConnectTimeout=10</string>
    <string>-o</string><string>StrictHostKeyChecking=accept-new</string>
    <!-- 必须禁用连接复用：~/.ssh/config 对 mac-mini 开了 ControlMaster auto +
         ControlPersist 10m，隧道的 ssh 若复用用户已有的 master 连接，-R 请求会落到
         那个 master 上、端口已被占用则直接失败（ExitOnForwardFailure），或者注册成功
         但隧道跟着 master 一起在 10 分钟空闲后被回收 —— 两种情况都表现为 launchd
         反复「running → spawn scheduled」，macmini 侧端口时通时断（2026-11-12 实测）。 -->
    <string>-o</string><string>ControlMaster=no</string>
    <string>-o</string><string>ControlPath=none</string>
    <string>-R</string><string>127.0.0.1:3425:127.0.0.1:3425</string>
    <string>mac-mini</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/Users/xhq/Library/Logs/magpie-tunnel.log</string>
  <key>StandardErrPath</key><string>/Users/xhq/Library/Logs/magpie-tunnel.err.log</string>
</dict>
</plist>